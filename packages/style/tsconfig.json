{
  "extends": "../../tsconfig.base.json",
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "compiler_old",
    "node_modules",
    "plugin_old",
    "dist",
    ".temp"
  ],
  "compilerOptions": {
    "lib": [
      "ES2020",
      "DOM"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "@fluentic/style/plugin/jsx",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "paths": {
      "@fluentic/style": [
        "./index.ts"
      ],
      "@fluentic/style/plugin/jsx": [
        "./jsx/index.ts"
      ],
      "@fluentic/style/plugin/jsx/*": [
        "./jsx/*"
      ]
    }
  }
}
