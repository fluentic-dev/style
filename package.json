{
  "name": "fluentic-style-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "pnpm --filter @fluentic/style build && pnpm --filter @example/* build && pnpm -r --filter @benchmark/app-* build",
    "bench": "pnpm --filter @fluentic/style build && pnpm --filter @benchmark/main bench",
    "bench:stable": "BENCH_PRESET=stable pnpm bench",
    "bench:stress": "BENCH_PRESET=stress pnpm bench",
    "bench:correctness": "pnpm --filter @benchmark/main bench:correctness",
    "bench:dynamic-values": "pnpm --filter @fluentic/style build && pnpm --filter @benchmark/main bench:dynamic-values",
    "bench:fluentic-cache": "pnpm --filter @fluentic/style build && pnpm --filter @benchmark/main bench:fluentic-cache",
    "bench:ssr-style": "pnpm --filter @fluentic/style build && pnpm --filter @benchmark/main bench:ssr-style",
    "bench:compiler": "pnpm --filter @fluentic/style build && pnpm --filter @benchmark/main bench:compiler",
    "bench:autocomplete": "pnpm --filter @benchmark/main bench:autocomplete",
    "sync:package-readme": "node scripts/sync-package-readme.mjs copy",
    "test": "pnpm --filter @fluentic/style test && pnpm test:bundle-report",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm release:check && node scripts/sync-package-readme.mjs run pnpm exec changeset publish --no-git-tag",
    "snapshot:style": "pnpm --filter @fluentic/style test && pnpm --filter @example/snapshots generate",
    "format": "DPRINT_CACHE_DIR=$PWD/.dprint-cache dprint fmt",
    "format:check": "DPRINT_CACHE_DIR=$PWD/.dprint-cache dprint check",
    "formatcheck": "pnpm run format:check",
    "typecheck": "node scripts/typecheck-workspace.mjs",
    "check": "node scripts/check-workspace.mjs",
    "lint": "oxlint .",
    "lintcheck": "pnpm run lint",
    "lint:fix": "oxlint . --fix",
    "test:package": "node scripts/test-package.mjs",
    "release:check": "pnpm --filter @fluentic/style build && pnpm report:bundle:check && pnpm check && pnpm test && pnpm build && pnpm --filter @example/nextjs test:prod && pnpm test:package",
    "llms:check": "node scripts/sync-llms.mjs --check && pnpm --filter @fluentic/style build && pnpm --filter @example/llm-basic typecheck && pnpm --filter @example/llm-basic build",
    "report:bundle": "pnpm --filter @fluentic/style report:bundle",
    "report:bundle:update": "pnpm --filter @fluentic/style report:bundle --write",
    "report:bundle:check": "pnpm --filter @fluentic/style report:bundle --check",
    "test:bundle-report": "node --test packages/style/scripts/bundle-report.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "dprint": "^0.54.0",
    "oxlint": "^1.68.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-native": "npm:typescript@7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "dprint",
      "esbuild",
      "sharp"
    ]
  }
}
